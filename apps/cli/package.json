{
  "name": "@webmesh/cli",
  "version": "0.1.0",
  "description": "Search, fetch, and browse the web from your AI agent.",
  "license": "MIT",
  "type": "module",
  "keywords": ["mcp", "web-search", "web-fetch", "browser", "ai-agents"],
  "bin": {
    "webmesh": "dist/webmesh.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts --target bun --outfile dist/webmesh.js --external impit && cp ../../README.md ../../LICENSE .",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "agent-browser": "0.38.1",
    "impit": "^0.14.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/bun": "catalog:",
    "@webmesh/core": "workspace:*",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
